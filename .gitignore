
# ==========================================
# DairyPro Command Center - Git Ignore
# ==========================================

# Environment variables and secrets
.env
.env.*
!.env.example
!.env.template

# Python virtual environments
venv/
.venv/
env/
ENV/
.python-version

# Python cache and compiled files
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# Python build files
build/
dist/
*.egg-info/
.eggs/
wheels/
pip-wheel-metadata/

# Flask instance and local configuration
instance/
.webassets-cache/

# Application logs
*.log
logs/
log/

# Database dumps and backup files
*.sql
*.sql.gz
*.sql.zip
*.dump
*.bak
*.backup
*.db
*.sqlite
*.sqlite3

# Database backup directories
backups/
database_backups/
db_backups/
DairyPro_Backups/

# Uploads and temporary files
uploads/
temp/
tmp/
*.tmp
*.temp

# Runtime and process files
*.pid
*.sock

# Testing and coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
test-results/
coverage.xml

# Type checking and linting
.mypy_cache/
.pyright/
.ruff_cache/

# Jupyter
.ipynb_checkpoints/

# IDE and editor files
.vscode/
.idea/
*.sublime-workspace
*.sublime-project

# Operating system files
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# Node.js (if frontend tooling is added)
node_modules/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Local environment and deployment files
*.local
*.development
*.production.local

# Temporary exports
exports/
*.csv.tmp
*.xlsx.tmp
*.pdf.tmp

# Security and secret files
*.pem
*.key
*.crt
*.p12
*.pfx
secrets/
credentials/
service-account*.json

# Keep required project files
!.gitignore
!requirements.txt
!README.md
!app.py
!static/
!templates/
!migrations/
